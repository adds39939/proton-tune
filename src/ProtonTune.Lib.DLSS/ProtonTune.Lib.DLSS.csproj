<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Carries the DLSS libraries ProtonTune ships. There is no code here: the project exists so
      that referencing it is all an application needs to do to have the libraries laid out beside
      it, rather than every application repeating a glob into a folder at the repository root.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!--
      Copied into lib/dlss/<version>/ of whatever references this, which is where
      ShippedDlssRuntimeProvider looks. The version is the directory name, so shipping another
      release means adding a directory next to this one and nothing else.

      They are large, so they are copied only when they change.
    -->
    <ItemGroup>
        <Content Include="dlss/**/*.dll"
                 TargetPath="lib/dlss/%(RecursiveDir)%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
