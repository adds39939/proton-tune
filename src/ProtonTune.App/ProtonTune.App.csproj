<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
      <PackageReference Include="PhotinoX.Blazor" Version="4.3.2" />
    </ItemGroup>

    <!--
      The DLSS libraries ship with the application, in versioned directories so several can be
      offered at once. They are large, so they are copied only when they change.
    -->
    <ItemGroup>
      <Content Include="..\..\lib\dlss\**\*.dll"
               Link="lib\dlss\%(RecursiveDir)%(Filename)%(Extension)"
               CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ProtonTune.Services\ProtonTune.Services.csproj" />
      <ProjectReference Include="..\ProtonTune.UI\ProtonTune.UI.csproj" />
    </ItemGroup>

</Project>
