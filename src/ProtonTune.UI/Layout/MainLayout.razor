@inherits LayoutComponentBase

<div class="app-shell">
    <header class="titlebar">
        <span class="wordmark">Proton<strong>Tune</strong></span>
    </header>

    <nav class="nav">
        @foreach (var item in NavItems)
        {
            <NavLink class="nav-tab" href="@item.Path" Match="@item.Match" @key="item.Path">
                @item.Label
            </NavLink>
        }
    </nav>

    <main class="content">
        @Body
    </main>
</div>
