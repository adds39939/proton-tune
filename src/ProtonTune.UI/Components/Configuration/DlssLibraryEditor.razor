@if (Latest is null)
{
    <p class="note">No DLSS libraries are shipped with this build of ProtonTune.</p>
}
else if (!Status.HasLibraries)
{
    <p class="note">This game has no DLSS libraries to replace.</p>
}
else
{
    <div class="upgrade">
        <div class="upgrade-label">
            <span class="upgrade-name">Upgrade DLSS libraries to @Latest.Version</span>
            <span class="upgrade-description">
                Points the game's DLSS libraries at the newer ones shipped with ProtonTune. The
                originals are kept and can be restored at any time.
            </span>
        </div>

        <div class="upgrade-control">
            <label class="switch">
                <input type="checkbox" checked="@Status.IsManaged" disabled="@IsBusy" @onchange="OnToggled"/>
                <span>@(IsBusy ? "Working…" : Status.IsManaged ? "On" : "Off")</span>
            </label>
        </div>
    </div>

    <p class="caution">
        Replacing a game's DLSS libraries modifies files inside its install. Some anti-cheat
        systems object to that, and it is on you to judge whether a given game is safe to change.
        Steam also restores the originals whenever it verifies or updates the game, so ProtonTune
        adds a small script to the launch options that re-applies the links each time it starts.
    </p>

    @if (Status.HasForeignLinks)
    {
        <p class="caution">
            Some of these are already linked somewhere else — an arrangement made outside
            ProtonTune. Turning this on will point them at ProtonTune's copy instead.
        </p>
    }

    @if (Error is not null)
    {
        <p class="error">@Error</p>
    }

    <h4 class="group">Libraries found</h4>

    @foreach (var library in Status.Libraries)
    {
        <div class="library" @key="library.Path">
            <div class="library-label">
                <code class="library-name">@library.FileName</code>
                <span class="library-path">@library.RelativePath</span>
            </div>

            <span class="state state-@library.State.ToString().ToLowerInvariant()">
                @StateLabel(library.State)
            </span>
        </div>
    }
}
