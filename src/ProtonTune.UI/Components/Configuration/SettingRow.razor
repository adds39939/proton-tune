<div class="row">
    <div class="row-label">
        <span class="row-name">@Label</span>
        @if (Description is not null)
        {
            <span class="row-description">@Description</span>
        }
    </div>

    <div class="row-detail">
        <code class="row-value">@Value</code>
        <code class="row-variable">@Variable</code>
    </div>
</div>
