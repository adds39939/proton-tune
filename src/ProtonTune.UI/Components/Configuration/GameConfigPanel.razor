<section class="config" @onkeydown="OnKeyDown">
    @if (Entry is null)
    {
        <header class="config-header">
            <div class="config-heading">
                <h1 class="config-title">@(IsLoading ? "Loading…" : "Unknown game")</h1>
                <p class="config-subtitle">App ID @AppId</p>
            </div>

            <Button OnClick="Back">Back to library</Button>
        </header>

        @if (IsLoading)
        {
            <p class="config-message">Reading the library…</p>
        }
        else
        {
            <p class="config-message config-message-error">
                @(LoadError ?? "No installed game has that app ID.")
            </p>
        }
    }
    else
    {
        <header class="config-header">
            <GameArtwork AppId="@Entry.AppId" Name="@Entry.Name" Kind="GameArtworkKind.Header"/>

            <div class="config-heading">
                <h1 class="config-title" title="@Entry.Name">@Entry.Name</h1>
                <p class="config-subtitle">App ID @Entry.AppId</p>
            </div>

            <div class="config-actions">
                <Button Variant="@(LaunchPending ? ButtonVariant.Danger : ButtonVariant.Default)"
                        Disabled="@IsSaving"
                        OnClick="Launch">
                    @(LaunchPending ? "Launch anyway" : "Launch game")
                </Button>

                <Button OnClick="Back">Back to library</Button>
            </div>
        </header>

        @if (IsLoading)
        {
            <p class="config-message">Reading launch options…</p>
        }
        else if (LoadError is not null)
        {
            <p class="config-message config-message-error">@LoadError</p>
        }
        else
        {
            <div class="config-editor">
                <LaunchOptionsEditor @ref="Editor"
                                     Options="@Editing"
                                     OptionsChanged="OnOptionsChanged"
                                     Entry="@Entry"
                                     CompatTool="@CompatTool"
                                     CompatToolChanged="OnCompatToolChanged"
                                     Build="@EffectiveBuild"
                                     IsBusy="@IsSaving">
                    <Leading>
                        <label class="switch">
                            <input type="checkbox"
                                   checked="@UsesGlobal"
                                   disabled="@IsSaving"
                                   @onchange="@(args => OnUseGlobalChanged(args.Value is true))"/>
                            <span>Use Global</span>
                        </label>

                        <span class="global-note">
                            @if (UsesGlobal)
                            {
                                <text>
                                    Following the global profile. Changing any setting below makes
                                    these the game's own, keeping whatever the profile put there.
                                </text>
                            }
                            else
                            {
                                <text>Configured on its own. Turning this on replaces the settings below.</text>
                            }
                        </span>
                    </Leading>
                </LaunchOptionsEditor>

                <footer class="config-footer">
                    <div class="footer-status">
                        @if (SaveMessage is not null)
                        {
                            <span class="@StatusClass">@SaveMessage</span>
                        }
                        else if (GameIsRunning)
                        {
                            <span class="status-warning">
                                A game is running. Close it before changing launch options.
                            </span>
                        }
                        else if (HasChanges && WillRestartSteam)
                        {
                            <span class="status-warning">
                                Steam is running. Saving will close it and start it again — it keeps
                                this file in memory and would otherwise overwrite the change on exit.
                            </span>
                        }
                        else if (HasChanges)
                        {
                            <span>Unsaved changes.</span>
                        }
                    </div>

                    <div class="footer-actions">
                        <Button Disabled="@IsSaving" OnClick="AskToCopy">
                            Copy config from…
                        </Button>

                        <Button Variant="@(ResetPending ? ButtonVariant.Danger : ButtonVariant.Default)"
                                Disabled="@(IsSaving || GameIsRunning || !HasAnythingToReset)"
                                OnClick="ResetAsync">
                            @(ResetPending ? "Confirm reset" : "Reset")
                        </Button>

                        <Button Disabled="@(!HasChanges || IsSaving)" OnClick="Revert">
                            Revert
                        </Button>

                        <Button Variant="ButtonVariant.Primary"
                                Disabled="@(!HasChanges || IsSaving || GameIsRunning)"
                                OnClick="AskToSave">
                            @(IsSaving ? "Saving…" : WillRestartSteam ? "Save and restart Steam" : "Save")
                        </Button>
                    </div>
                </footer>
            </div>
        }
    }
</section>

@if (IsChoosingSource && Entry is not null)
{
    <CopyConfigDialog Entry="@Entry" OnChoose="CopyFrom" OnCancel="CancelCopy"/>
}

@if (IsConfirmingSave && Entry is not null)
{
    <SaveConfirmation Options="@Editing"
                      Saved="@Saved"
                      Subject="@Entry.Name"
                      AlsoChanging="@PendingSideEffects"
                      WillRestartSteam="@WillRestartSteam"
                      IsBusy="@IsSaving"
                      OnConfirm="SaveAsync"
                      OnCancel="CancelSave"/>
}
