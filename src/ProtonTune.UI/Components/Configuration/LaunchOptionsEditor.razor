@* Shared by the game dialog and the Global page: the same settings, driven by whatever
   LaunchOptions it is given. *@
<div class="panel-body">
    <nav class="sections" aria-label="Setting sections">
        @* Which build a game runs under is not a launch option — it is a different file, and one
           only a real game has. It leads because everything below it depends on it. *@
        @if (Entry is not null)
        {
            <button type="button"
                    class="section-tab @(SelectedSpecial == ProtonSection ? "is-active" : string.Empty)"
                    @onclick="() => SelectSpecial(ProtonSection)">
                <span>@ProtonSection</span>
            </button>

            <hr class="section-divider"/>
        }

        @foreach (var category in SettingCategories.InDisplayOrder)
        {
            var count = SetCountIn(category);

            <button type="button"
                    class="section-tab @(SelectedCategory == category ? "is-active" : string.Empty)"
                    @key="category"
                    @onclick="() => SelectCategory(category)">
                <span>@category.Title()</span>
                @if (count > 0)
                {
                    <span class="section-count">@count</span>
                }
            </button>
        }

        <hr class="section-divider"/>

        <button type="button"
                class="section-tab @(SelectedSpecial == LaunchChainSection ? "is-active" : string.Empty)"
                @onclick="() => SelectSpecial(LaunchChainSection)">
            <span>@LaunchChainSection</span>
            <span class="section-count">@Options.Wrapper.Count</span>
        </button>

        <button type="button"
                class="section-tab @(SelectedSpecial == CustomSection ? "is-active" : string.Empty)"
                @onclick="() => SelectSpecial(CustomSection)">
            <span>@CustomSection</span>
            <span class="section-count">@CustomVariables.Count</span>
        </button>

        <button type="button"
                class="section-tab @(SelectedSpecial == RawSection ? "is-active" : string.Empty)"
                @onclick="() => SelectSpecial(RawSection)">
            <span>@RawSection</span>
        </button>
    </nav>

    <div class="section-content">
        @if (Warnings.Count > 0)
        {
            <ul class="warnings">
                @foreach (var warning in Warnings)
                {
                    <li @key="warning">@warning</li>
                }
            </ul>
        }

        @if (SelectedCategory is SettingCategory.MangoHud)
        {
            <h3 class="section-title">MangoHud</h3>
            <p class="section-note">
                The overlay's own options, written into a single MANGOHUD_CONFIG variable.
                They only apply when the game is launched through mangohud.
            </p>

            <CommandToggle Label="Launch through MangoHud"
                           Command="@MangoHudCommand"
                           Description="Adds mangohud to the launch chain. Without it none of these options apply."
                           IsOn="@Options.HasWrapperCommand(MangoHudCommand)"
                           IsOnChanged="@(on => ApplyWrapperCommand(MangoHudCommand, on))"/>

            <MangoHudEditor Value="@Options.FindEnvironment(MangoHudVariable)?.Value"
                            ValueChanged="@(value => ApplySetting(MangoHudDefinition, value))"/>
        }
        else if (SelectedCategory is { } selected)
        {
            <h3 class="section-title">@selected.Title()</h3>

            @if (selected is SettingCategory.Cpu)
            {
                <CpuAffinityEditor Value="@Options.CpuAffinity"
                                   ValueChanged="ApplyCpuAffinity"/>

                <h4 class="section-subtitle">Scheduling</h4>

                <CommandToggle Label="Launch through GameMode"
                               Command="@GameModeCommand"
                               Description="Asks the system to favour the game while it runs."
                               IsOn="@Options.HasWrapperCommand(GameModeCommand)"
                               IsOnChanged="@(on => ApplyWrapperCommand(GameModeCommand, on))"/>
            }

            @* Libraries belong to an install, so the global profile has none to show. *@
            @if (selected is SettingCategory.Dlss && Entry is { } game)
            {
                <h4 class="section-subtitle">Libraries</h4>

                @if (BuildUpgradesDlss)
                {
                    <p class="section-note">
                        @BuildName replaces these libraries itself, through the setting below, and
                        without touching the files in the install. ProtonTune's own swap is not
                        offered here: two mechanisms over the same files would fight.
                    </p>

                    @if (DlssIsManaged)
                    {
                        <p class="section-warning">
                            This game still has ProtonTune's libraries linked in from an earlier
                            build. Reset the game to put its own back before relying on Proton's.
                        </p>
                    }
                }
                else
                {
                    <DlssLibraryEditor Entry="@game" ScriptChanged="OnDlssScriptChanged"/>
                }

                @foreach (var definition in ProtonDlssSettings)
                {
                    <SettingEditor Definition="@definition"
                                   Value="@Options.FindEnvironment(definition.Variable)?.Value"
                                   ValueChanged="@(value => ApplySetting(definition, value))"
                                   IsIgnored="@Capabilities.Ignores(definition.Variable)"
                                   BuildName="@BuildName"
                                   @key="definition.Variable"/>
                }

                <h4 class="section-subtitle">Driver overrides</h4>
            }

            @foreach (var definition in ListedSettingsIn(selected))
            {
                <SettingEditor Definition="@definition"
                               Value="@Options.FindEnvironment(definition.Variable)?.Value"
                               ValueChanged="@(value => ApplySetting(definition, value))"
                               IsIgnored="@Capabilities.Ignores(definition.Variable)"
                               BuildName="@BuildName"
                               @key="definition.Variable"/>
            }
        }
        else
            switch (SelectedSpecial)
            {
                case ProtonSection when Entry is { } protonGame:
                {
                    <h3 class="section-title">Proton</h3>
                    <p class="section-note">
                        The compatibility build the game runs under. Saved with everything else, in
                        the same trip through Steam.
                    </p>

                    <ProtonVersionEditor AppId="@protonGame.AppId"
                                         Value="@CompatTool"
                                         ValueChanged="@CompatToolChanged"
                                         IsBusy="@IsBusy"/>
                    break;
                }
                case LaunchChainSection:
                {
                    <h3 class="section-title">Launch chain</h3>
                    <p class="section-note">
                        Commands the game is launched through, in order. Not editable here yet —
                        change it in the raw options for now.
                    </p>

                    if (Options.Wrapper.Count == 0)
                    {
                        <p class="section-empty">The game is launched directly.</p>
                    }
                    else
                    {
                        <ol class="chain">
                            @foreach (var token in Options.Wrapper)
                            {
                                <li><code>@token</code></li>
                            }
                        </ol>
                    }

                    <SettingRow Label="Command placeholder"
                                Variable="%command%"
                                Value="@(Options.HasCommandPlaceholder ? "present" : "absent — options are appended")"
                                Description="Where Steam substitutes the game's own command line."/>

                    if (Options.Arguments.Count > 0)
                    {
                        <SettingRow Label="Game arguments"
                                    Variable="after %command%"
                                    Value="@string.Join(' ', Options.Arguments)"
                                    Description="Passed to the game itself."/>
                    }

                    break;
                }
                case CustomSection:
                {
                    <h3 class="section-title">Custom variables</h3>
                    <p class="section-note">
                        Anything ProtonTune has no definition for, plus whatever you want to add.
                    </p>

                    foreach (var variable in CustomVariables)
                    {
                        <div class="custom" @key="variable.Name">
                            <code class="custom-name">@variable.Name</code>

                            <input class="custom-value"
                                   type="text"
                                   spellcheck="false"
                                   value="@variable.Value"
                                   @onchange="@(args => SetCustomVariable(variable.Name, args.Value?.ToString()))"/>

                            <button type="button"
                                    class="button button-quiet"
                                    @onclick="() => RemoveCustomVariable(variable.Name)">
                                Remove
                            </button>
                        </div>
                    }

                    <div class="custom custom-new">
                        <input class="custom-name-input"
                               type="text"
                               spellcheck="false"
                               placeholder="VARIABLE_NAME"
                               value="@NewVariableName"
                               @onchange="@(args => NewVariableName = args.Value?.ToString() ?? string.Empty)"/>

                        <input class="custom-value"
                               type="text"
                               spellcheck="false"
                               placeholder="value"
                               value="@NewVariableValue"
                               @onchange="@(args => NewVariableValue = args.Value?.ToString() ?? string.Empty)"/>

                        <button type="button" class="button" @onclick="AddCustomVariable">Add</button>
                    </div>
                    break;
                }
                default:
                    <h3 class="section-title">Raw launch options</h3>
                    <p class="section-note">
                        The whole string, as Steam stores it. Editing here is the escape hatch for
                        anything ProtonTune does not yet understand.
                    </p>

                    <textarea class="raw-editor"
                      rows="6"
                      spellcheck="false"
                      placeholder="No launch options are set."
                      disabled="@IsBusy"
                      value="@RawDraft"
                      @oninput="OnRawInput"></textarea>
                    break;
            }

        @if (HasChanges)
        {
            <div class="preview">
                <div class="preview-heading">
                    <span class="preview-label">Will be written as</span>
                    <span class="legend">
                        <span class="legend-item legend-added">added</span>
                        <span class="legend-item legend-removed">removed</span>
                    </span>
                </div>

                @* The separator is an explicit expression: a whitespace-only literal
                   gets trimmed away, and the tokens then run together unreadably. *@
                <pre class="raw">@foreach (var token in PreviewDiff)
{<span class="token token-@token.Kind.ToString().ToLowerInvariant()">@token.Text</span>@(" ")}</pre>
            </div>
        }
    </div>
</div>
