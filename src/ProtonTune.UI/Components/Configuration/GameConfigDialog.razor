<div class="backdrop" @onkeydown="OnKeyDown">
    <div class="panel" role="dialog" aria-modal="true" aria-label="@($"Configure {Entry.Name}")">
        <header class="panel-header">
            <GameArtwork AppId="@Entry.AppId" Name="@Entry.Name" Kind="GameArtworkKind.Header"/>

            <div class="panel-heading">
                <h2 class="panel-title" title="@Entry.Name">@Entry.Name</h2>
                <p class="panel-subtitle">App ID @Entry.AppId</p>
            </div>

            <button type="button" class="button" @onclick="Close" autofocus>Close</button>
        </header>

        @if (IsLoading)
        {
            <p class="panel-message">Reading launch options…</p>
        }
        else if (LoadError is not null)
        {
            <p class="panel-message panel-message-error">@LoadError</p>
        }
        else
        {
            <div class="panel-body">
                <nav class="sections" aria-label="Setting sections">
                    @foreach (var item in Sections)
                    {
                        <button type="button"
                                class="section-tab @(SelectedSection == item.Title ? "is-active" : string.Empty)"
                                @key="item.Title"
                                @onclick="() => SelectSection(item.Title)">
                            <span>@item.Title</span>
                            <span class="section-count">@item.Settings.Count</span>
                        </button>
                    }

                    <hr class="section-divider"/>

                    <button type="button"
                            class="section-tab @(SelectedSection == LaunchChainSection ? "is-active" : string.Empty)"
                            @onclick="() => SelectSection(LaunchChainSection)">
                        <span>@LaunchChainSection</span>
                        <span class="section-count">@Options.Wrapper.Count</span>
                    </button>

                    <button type="button"
                            class="section-tab @(SelectedSection == CustomSection ? "is-active" : string.Empty)"
                            @onclick="() => SelectSection(CustomSection)">
                        <span>@CustomSection</span>
                        <span class="section-count">@CustomVariables.Count</span>
                    </button>

                    <button type="button"
                            class="section-tab @(SelectedSection == RawSection ? "is-active" : string.Empty)"
                            @onclick="() => SelectSection(RawSection)">
                        <span>@RawSection</span>
                    </button>
                </nav>

                <div class="section-content">
                    @if (SelectedSection == LaunchChainSection)
                    {
                        <h3 class="section-title">Launch chain</h3>
                        <p class="section-note">
                            Commands the game is launched through, in order. ProtonTune keeps unknown
                            entries exactly where they are.
                        </p>

                        @if (Options.Wrapper.Count == 0)
                        {
                            <p class="section-empty">The game is launched directly.</p>
                        }
                        else
                        {
                            <ol class="chain">
                                @foreach (var token in Options.Wrapper)
                                {
                                    <li><code>@token</code></li>
                                }
                            </ol>
                        }

                        <SettingRow Label="Command placeholder"
                                    Variable="%command%"
                                    Value="@(Options.HasCommandPlaceholder ? "present" : "absent — options are appended")"
                                    Description="Where Steam substitutes the game's own command line."/>

                        @if (Options.Arguments.Count > 0)
                        {
                            <SettingRow Label="Game arguments"
                                        Variable="after %command%"
                                        Value="@string.Join(' ', Options.Arguments)"
                                        Description="Passed to the game itself."/>
                        }
                    }
                    else if (SelectedSection == CustomSection)
                    {
                        <h3 class="section-title">Custom variables</h3>
                        <p class="section-note">
                            Environment variables ProtonTune has no definition for. They are preserved
                            untouched.
                        </p>

                        @if (CustomVariables.Count == 0)
                        {
                            <p class="section-empty">Every variable set on this game is recognised.</p>
                        }
                        else
                        {
                            @foreach (var variable in CustomVariables)
                            {
                                <SettingRow Label="@variable.Name"
                                            Variable="@variable.Name"
                                            Value="@variable.Value"
                                            @key="variable.Name"/>
                            }
                        }
                    }
                    else if (SelectedSection == RawSection)
                    {
                        <h3 class="section-title">Raw launch options</h3>
                        <p class="section-note">
                            The whole string, as Steam stores it. Editing here is the escape hatch for
                            anything ProtonTune does not yet understand.
                        </p>

                        <textarea class="raw-editor"
                                  rows="6"
                                  spellcheck="false"
                                  placeholder="No launch options are set."
                                  disabled="@IsSaving"
                                  value="@Draft"
                                  @oninput="OnDraftChanged"></textarea>

                        @if (HasChanges)
                        {
                            <div class="preview">
                                <span class="preview-label">Will be written as</span>
                                <pre class="raw">@Preview</pre>
                            </div>
                        }
                    }
                    else
                    {
                        @foreach (var item in Sections.Where(s => s.Title == SelectedSection))
                        {
                            <h3 class="section-title">@item.Title</h3>

                            @foreach (var setting in item.Settings)
                            {
                                <SettingRow Label="@setting.Definition.Label"
                                            Variable="@setting.Definition.Variable"
                                            Value="@setting.Value"
                                            Description="@setting.Definition.Description"
                                            @key="setting.Definition.Variable"/>
                            }
                        }
                    }
                </div>
            </div>

            <footer class="panel-footer">
                <div class="footer-status">
                    @if (SaveMessage is not null)
                    {
                        <span class="@(SaveFailed ? "status-error" : "status-success")">@SaveMessage</span>
                    }
                    else if (GameIsRunning)
                    {
                        <span class="status-warning">
                            A game is running. Close it before changing launch options.
                        </span>
                    }
                    else if (HasChanges && WillRestartSteam)
                    {
                        <span class="status-warning">
                            Steam is running. Saving will close it and start it again — it keeps this
                            file in memory and would otherwise overwrite the change on exit.
                        </span>
                    }
                    else if (HasChanges)
                    {
                        <span>Unsaved changes.</span>
                    }
                </div>

                <div class="footer-actions">
                    <button type="button"
                            class="button"
                            disabled="@(!HasChanges || IsSaving)"
                            @onclick="RevertDraft">
                        Revert
                    </button>

                    <button type="button"
                            class="button button-primary"
                            disabled="@(!HasChanges || IsSaving || GameIsRunning)"
                            @onclick="SaveAsync">
                        @(IsSaving ? "Saving…" : WillRestartSteam ? "Save and restart Steam" : "Save")
                    </button>
                </div>
            </footer>
        }
    </div>
</div>
