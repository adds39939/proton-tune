<div class="backdrop" @onkeydown="OnKeyDown">
    <div class="panel" role="dialog" aria-modal="true" aria-label="@($"Configure {Entry.Name}")">
        <header class="panel-header">
            <GameArtwork AppId="@Entry.AppId" Name="@Entry.Name" Kind="GameArtworkKind.Header"/>

            <div class="panel-heading">
                <h2 class="panel-title" title="@Entry.Name">@Entry.Name</h2>
                <p class="panel-subtitle">App ID @Entry.AppId</p>
            </div>

            <button type="button" class="button" @onclick="Close" autofocus>Close</button>
        </header>

        @if (IsLoading)
        {
            <p class="panel-message">Reading launch options…</p>
        }
        else if (LoadError is not null)
        {
            <p class="panel-message panel-message-error">@LoadError</p>
        }
        else
        {
            <div class="global-link">
                <label class="switch">
                    <input type="checkbox"
                           checked="@UsesGlobal"
                           disabled="@IsSaving"
                           @onchange="@(args => OnUseGlobalChanged(args.Value is true))"/>
                    <span>Use Global</span>
                </label>

                <span class="global-note">
                    @if (UsesGlobal)
                    {
                        <text>
                            Following the global profile. Changing any setting below makes these the
                            game's own, keeping whatever the profile put there.
                        </text>
                    }
                    else
                    {
                        <text>Configured on its own. Turning this on replaces the settings below.</text>
                    }
                </span>
            </div>

            <LaunchOptionsEditor Options="@Editing"
                                 OptionsChanged="OnOptionsChanged"
                                 Saved="@Saved"
                                 Entry="@Entry"
                                 IsBusy="@IsSaving"/>

            <footer class="panel-footer">
                <div class="footer-status">
                    @if (SaveMessage is not null)
                    {
                        <span class="@(SaveFailed ? "status-error" : "status-success")">@SaveMessage</span>
                    }
                    else if (GameIsRunning)
                    {
                        <span class="status-warning">
                            A game is running. Close it before changing launch options.
                        </span>
                    }
                    else if (HasChanges && WillRestartSteam)
                    {
                        <span class="status-warning">
                            Steam is running. Saving will close it and start it again — it keeps this
                            file in memory and would otherwise overwrite the change on exit.
                        </span>
                    }
                    else if (HasChanges)
                    {
                        <span>Unsaved changes.</span>
                    }
                </div>

                <div class="footer-actions">
                    <button type="button"
                            class="button @(ResetPending ? "button-danger" : string.Empty)"
                            disabled="@(IsSaving || GameIsRunning || !HasAnythingToReset)"
                            @onclick="ResetAsync">
                        @(ResetPending ? "Confirm reset" : "Reset")
                    </button>

                    <button type="button"
                            class="button"
                            disabled="@(!HasChanges || IsSaving)"
                            @onclick="Revert">
                        Revert
                    </button>

                    <button type="button"
                            class="button button-primary"
                            disabled="@(!HasChanges || IsSaving || GameIsRunning)"
                            @onclick="SaveAsync">
                        @(IsSaving ? "Saving…" : WillRestartSteam ? "Save and restart Steam" : "Save")
                    </button>
                </div>
            </footer>
        }
    </div>
</div>
