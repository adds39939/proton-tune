<section class="profile">
    <header class="profile-header">
        <div>
            <h1>Global</h1>
            <p class="profile-subtitle">
                Settings a game can adopt instead of being configured on its own.
            </p>
        </div>

        <div class="profile-actions">
            <Button Variant="@(ResetPending ? ButtonVariant.Danger : ButtonVariant.Default)"
                    Disabled="@IsSaving"
                    OnClick="ResetAsync">
                @(ResetPending ? "Confirm reset" : "Reset")
            </Button>

            <Button Disabled="@(!HasChanges || IsSaving)" OnClick="Revert">
                Revert
            </Button>

            <Button Variant="ButtonVariant.Primary"
                    Disabled="@(!HasChanges || IsSaving)"
                    OnClick="AskToSave">
                @(IsSaving ? "Saving…" : WillRestartSteam ? "Save and restart Steam" : "Save")
            </Button>
        </div>
    </header>

    @if (SaveMessage is not null)
    {
        <p class="profile-message @(SaveFailed ? "is-error" : "is-success")">@SaveMessage</p>
    }
    else if (LinkedCount > 0)
    {
        <p class="profile-message">
            @LinkedCount @(LinkedCount == 1 ? "game follows" : "games follow") this profile. Saving
            applies these settings to @(LinkedCount == 1 ? "it" : "them") too.
        </p>
    }

    @if (IsLoading)
    {
        <p class="profile-message">Reading the global profile…</p>
    }
    else
    {
        <div class="profile-editor">
            <LaunchOptionsEditor Options="@Editing"
                                 OptionsChanged="OnOptionsChanged"
                                 IsBusy="@IsSaving"/>
        </div>
    }
</section>

@if (IsConfirmingSave)
{
    <SaveConfirmation Options="@Editing"
                      Saved="@Saved"
                      Subject="the global profile"
                      AlsoChanging="@PendingSideEffects"
                      WillRestartSteam="@WillRestartSteam"
                      IsBusy="@IsSaving"
                      OnConfirm="SaveAsync"
                      OnCancel="CancelSave"/>
}
