@* A compound variable needs the whole width for its options, so it stacks below the label
   instead of sitting in the control column beside it. *@
<div class="setting @(IsIgnored ? "is-ignored" : string.Empty) @(Definition.Compound is null ? string.Empty : "is-compound")">
    <div class="setting-label">
        <span class="setting-name">@Definition.Label</span>
        @if (Definition.Description is not null)
        {
            <span class="setting-description">@Definition.Description</span>
        }
        <code class="setting-variable">@Definition.Variable</code>

        @if (IsIgnored)
        {
            <span class="setting-ignored">
                @(BuildName ?? "This Proton build") does not read this variable, so setting it has
                no effect.
            </span>
        }
    </div>

    @if (Definition.Compound is { } compound)
    {
        <div class="setting-compound">
            <CompoundEditor Schema="@compound" Value="@Value" ValueChanged="@ValueChanged"/>
        </div>
    }
    else
    {
    <div class="setting-control">
        @switch (Definition.Kind)
        {
            case SettingKind.Toggle:
                <label class="switch">
                    <input type="checkbox" checked="@IsOn" @onchange="OnToggled"/>
                    <span>@(IsOn ? "On" : "Off")</span>
                </label>

                break;

            case SettingKind.Choice:
                <span class="select-shell">
                    <select class="control" value="@(Value ?? string.Empty)" @onchange="OnChoicePicked">
                        <option value="">Not set</option>
                        @foreach (var choice in Choices)
                        {
                            <option value="@choice" @key="choice">@choice</option>
                        }
                    </select>

                    <ChevronIcon/>
                </span>

                break;

            case SettingKind.Number:
                <input class="control"
                       type="number"
                       placeholder="@Definition.Placeholder"
                       value="@(Value ?? string.Empty)"
                       @onchange="OnTextChanged"/>

                break;

            default:
                <input class="control"
                       type="text"
                       spellcheck="false"
                       placeholder="@Definition.Placeholder"
                       value="@(Value ?? string.Empty)"
                       @onchange="OnTextChanged"/>

                break;
        }
    </div>
    }
</div>
