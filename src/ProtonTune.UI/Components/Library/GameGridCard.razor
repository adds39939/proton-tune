<li class="game-tile">
    <GameArtwork AppId="@Entry.AppId" Name="@Entry.Name" Kind="GameArtworkKind.Capsule"/>

    <div class="tile-tags">
        <GameTags Entry="@Entry"/>
    </div>

    <div class="tile-body">
        <h2 class="tile-title" title="@Entry.Name">@Entry.Name</h2>
        <p class="tile-meta">
            @FileSizeDisplay.Format(Entry.SizeOnDisk) · @LastPlayedDisplay.Format(Entry.LastPlayed)
        </p>
    </div>

    @*
        A heading and a paragraph cannot legally sit inside a button, so the click target is an
        overlay stretched across the card rather than a wrapper around its content.
    *@
    <button type="button" class="card-overlay" @onclick="Select">
        <span class="sr-only">Configure @Entry.Name</span>
    </button>
</li>
