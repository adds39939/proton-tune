<section class="library">
    <header class="library-header">
        <div>
            <h1>Library</h1>
            <p class="library-subtitle">@SubtitleText</p>
        </div>

        <Button Disabled="@IsLoading" OnClick="LoadAsync">
            @(IsLoading ? "Scanning…" : "Rescan")
        </Button>
    </header>

    <div class="library-filters">
        <input class="search"
               type="search"
               placeholder="Search installed games…"
               value="@SearchTerm"
               @oninput="OnSearchChanged"/>

        <span class="select-shell">
            <select class="sort-select"
                    aria-label="Sort by"
                    title="Sort by"
                    value="@SortOrder"
                    @onchange="OnSortChanged">
                @foreach (var order in SortOrders)
                {
                    <option value="@order" @key="order">@order.Title()</option>
                }
            </select>

            <ChevronIcon/>
        </span>

        <div class="view-toggle" role="group" aria-label="View mode">
            @foreach (var mode in ViewModes)
            {
                <button type="button"
                        class="view-button @(ViewMode == mode ? "is-active" : string.Empty)"
                        aria-pressed="@(ViewMode == mode)"
                        aria-label="@mode"
                        title="@mode"
                        @key="mode"
                        @onclick="() => SetViewMode(mode)">
                    @if (mode == LibraryViewMode.List)
                    {
                        <ListIcon/>
                    }
                    else
                    {
                        <GridIcon/>
                    }
                </button>
            }
        </div>
    </div>

    @if (IsLoading)
    {
        <p class="library-message">Scanning Steam libraries…</p>
    }
    else if (LoadError is not null)
    {
        <p class="library-message library-message-error">@LoadError</p>
    }
    else if (VisibleApps.Count == 0)
    {
        <p class="library-message">@EmptyMessage</p>
    }
    else if (ViewMode == LibraryViewMode.Grid)
    {
        <ul class="game-grid">
            @foreach (var app in VisibleApps)
            {
                <GameGridCard Entry="@app" OnSelect="Select" @key="app.AppId"/>
            }
        </ul>
    }
    else
    {
        <ul class="game-list">
            @foreach (var app in VisibleApps)
            {
                <GameListCard Entry="@app" OnSelect="Select" @key="app.AppId"/>
            }
        </ul>
    }

    @if (SelectedApp is not null)
    {
        <GameConfigDialog Entry="@SelectedApp" OnClose="CloseDialog"/>
    }
</section>
